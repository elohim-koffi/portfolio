<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ELOHÏM-GESTION - Solution de Gestion Business Pro 2026</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#6366f1">
<style>
:root{
  --bg:#0b1120; --card:#111827; --glass:rgba(17,24,39,0.6);
  --text:#f9fafb; --muted:#9ca3af; --border:rgba(255,255,255,0.08);
  --primary:#6366f1; --indigo:#818cf8; --danger:#ef4444; --success:#22c55e;
  --wave:#1DC1EC; --mtn:#FFCC00; --orange:#FF7900; --cash:#10b981;
}
*{margin:0;padding:0;box-sizing:border-box;font-family:ui-sans-serif,system-ui,-apple-system}
body{background:var(--bg);color:var(--text);min-height:100vh;background-image:radial-gradient(at 27% 37%,hsla(215,98%,61%,0.15) 0px,transparent 50%),radial-gradient(at 97% 21%,hsla(125,98%,72%,0.15) 0px,transparent 50%)}
.container{max-width:500px;margin:0 auto;padding:20px}
.glass{
  background:var(--glass);backdrop-filter:blur(24px);
  border:1px solid var(--border);border-radius:24px;
  padding:24px;margin-bottom:20px;box-shadow:0 10px 40px rgba(0,0,0,0.4)
}
.brand{text-align:center;margin:20px 0 30px 0}
.brand h1{font-size:32px;font-weight:900;letter-spacing:-1px}
.brand h1 span{background:linear-gradient(90deg,var(--primary),var(--indigo));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.brand p{color:var(--muted);font-size:14px;margin-top:4px}
h2{font-size:22px;font-weight:800;margin-bottom:16px}
input,select,button{
  width:100%;padding:16px;border-radius:14px;border:1px solid var(--border);
  background:rgba(11,17,32,0.8);color:var(--text);font-size:16px;margin:10px 0;
  transition:all 0.2s
}
input:focus{border-color:var(--primary);outline:none}
button{background:var(--primary);border:none;font-weight:700;cursor:pointer}
button:active{transform:scale(0.97)}
.btn-danger{background:var(--danger)}
.btn-success{background:var(--success)}
.btn-dark{background:#374151}
.row{display:flex;gap:12px}
.row>div{flex:1}
.hide{display:none}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
.biz-name{font-size:20px;font-weight:800}
.owner-name{color:var(--muted);font-size:13px}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:16px 0}
.stat{background:rgba(11,17,32,0.6);padding:16px;border-radius:16px;border:1px solid var(--border)}
.stat .label{color:var(--muted);font-size:12px}
.stat .value{font-size:24px;font-weight:800;margin-top:4px}
.pay-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0}
.pay-btn{padding:12px 8px;font-size:13px;border:2px solid transparent;opacity:0.6}
.pay-btn.active{opacity:1;border-color:#fff;transform:scale(1.05)}
.badge{padding:5px 12px;border-radius:20px;font-size:11px;font-weight:800;text-transform:uppercase}
.badge-wave{background:var(--wave);color:#000}
.badge-mtn{background:var(--mtn);color:#000}
.badge-orange{background:var(--orange);color:#000}
.badge-cash{background:var(--cash);color:#000}
table{width:100%;border-collapse:collapse;margin-top:16px}
td,th{padding:14px 8px;border-bottom:1px solid var(--border);text-align:left;font-size:14px}
th{color:var(--muted);font-size:12px;text-transform:uppercase}
.float-menu{position:fixed;bottom:20px;right:20px;display:flex;flex-direction:column;gap:12px;z-index:9999}
.float-btn{
  width:60px;height:60px;border-radius:50%;display:flex;
  align-items:center;justify-content:center;font-size:24px;
  box-shadow:0 6px 20px rgba(0,0,0,0.5);border:none
}
.tabs{display:flex;background:rgba(11,17,32,0.6);border-radius:14px;padding:4px;margin-bottom:20px}
.tab{flex:1;padding:12px;text-align:center;border-radius:10px;cursor:pointer;font-weight:600;font-size:14px}
.tab.active{background:var(--primary)}
.powered{position:fixed;bottom:10px;left:0;right:0;text-align:center;font-size:11px;color:var(--muted);opacity:0.6}
.label-form{font-size:13px;color:var(--muted);margin:14px 0 6px 0;display:block}

/* STYLE IMPRESSION */
@media print{
  body{background:#fff;color:#000}
  .container,.glass{background:#fff;border:none;box-shadow:none;padding:0;margin:0}
  .tabs,.float-menu,.brand,.header button,.btn-success,.pay-grid,.label-form,button,input,select,.powered{display:none!important}
  #printArea{display:block!important}
  .print-header{text-align:center;margin-bottom:20px;border-bottom:2px solid #000;padding-bottom:10px}
  .print-header h1{font-size:24px;color:#000}
  .print-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:20px 0}
  .print-stat{border:1px solid #000;padding:10px;text-align:center}
  .print-table{width:100%;border-collapse:collapse;margin-top:20px}
  .print-table th,.print-table td{border:1px solid #000;padding:8px;font-size:12px}
  .print-footer{margin-top:30px;text-align:center;font-size:11px}
}
#printArea{display:none}
</style>
</head>
<body>

<!-- ONBOARDING -->
<div id="onboardScreen" class="container hide">
  <div class="brand">
    <h1>ELOHÏM<span>-GESTION</span></h1>
    <p>La solution de gestion #1 pour TPE/PME en 2026</p>
  </div>
  <div class="glass">
    <h2>Configurez votre entreprise</h2>
    <label class="label-form">Nom de votre entreprise</label>
    <input id="nomBusiness" placeholder="Ex: ETS Koffi, Salon Belle Vue, Bar Le Référence">
    <label class="label-form">Secteur d'activité</label>
    <select id="secteur">
      <option value="">Choisissez votre secteur</option>
      <option>Bar / Cave / Maquis</option>
      <option>Boutique / Commerce</option>
      <option>Salon de coiffure / Beauté</option>
      <option>Restaurant / Restauration</option>
      <option>Prestation de service</option>
      <option>Autre</option>
    </select>
    <label class="label-form">Votre nom & prénom</label>
    <input id="nomProprio" placeholder="Gérant / Propriétaire">
    <label class="label-form">Numéro WhatsApp</label>
    <input id="numeroProprio" type="tel" placeholder="Ex: 0707070707">
    <label class="label-form">Mot de passe sécurisé</label>
    <input id="mdpProprio" type="password" placeholder="Minimum 4 caractères">
    <button onclick="creerCompte()">Activer mon ELOHÏM-GESTION 🚀</button>
    <p style="text-align:center;color:var(--muted);font-size:12px;margin-top:16px">100% sécurisé. Données stockées sur votre appareil.</p>
  </div>
</div>

<!-- LOGIN -->
<div id="loginScreen" class="container hide">
  <div class="brand">
    <h1>ELOHÏM<span>-GESTION</span></h1>
    <p id="bizNameLogin" style="font-weight:700;margin-top:8px"></p>
  </div>
  <div class="glass">
    <h2>Connexion Gérant</h2>
    <input id="loginNumero" type="tel" placeholder="Votre numéro WhatsApp">
    <input id="loginMdp" type="password" placeholder="Mot de passe">
    <button onclick="connexion()">Accéder à mon business</button>
  </div>
</div>

<!-- APP -->
<div id="appScreen" class="container hide">
  <div class="header">
    <div>
      <div class="biz-name" id="nomBizHeader"></div>
      <div class="owner-name" id="nomProprioHeader"></div>
    </div>
    <button style="width:auto;padding:10px 16px;font-size:14px" onclick="deconnexion()">Quitter</button>
  </div>

  <div class="tabs">
    <div class="tab active" onclick="switchTab('vente')">Vente</div>
    <div class="tab" onclick="switchTab('stats')">Stats</div>
    <div class="tab" onclick="switchTab('params')">Réglages</div>
  </div>

  <!-- ONGLET VENTE -->
  <div id="tabVente" class="glass">
    <h2>Nouvelle Transaction</h2>
    <label class="label-form">Produit / Service</label>
    <input id="produit" placeholder="Ex: Coca 33cl, Coupe homme, Plat du jour">
    <div class="row">
      <div>
        <label class="label-form">Prix unitaire FCFA</label>
        <input id="prix" type="number" placeholder="0">
      </div>
      <div>
        <label class="label-form">Quantité</label>
        <input id="qte" type="number" placeholder="1" value="1">
      </div>
    </div>
    <label class="label-form">Mode d'encaissement</label>
    <div class="pay-grid">
      <button class="pay-btn" onclick="selectPay('Wave')" id="btnWave" style="background:var(--wave);color:#000">Wave</button>
      <button class="pay-btn" onclick="selectPay('MTN')" id="btnMTN" style="background:var(--mtn);color:#000">MTN</button>
      <button class="pay-btn" onclick="selectPay('Orange')" id="btnOrange" style="background:var(--orange);color:#000">Orange</button>
      <button class="pay-btn" onclick="selectPay('Cash')" id="btnCash" style="background:var(--cash);color:#000">Cash</button>
    </div>
    <button class="btn-success" onclick="ajouterVente()">Encaisser +<span id="totalPreview">0</span> FCFA</button>
  </div>

  <!-- ONGLET STATS -->
  <div id="tabStats" class="glass hide">
    <h2>Performance du jour</h2>
    <div class="stats">
      <div class="stat">
        <div class="label">Chiffre d'affaires</div>
        <div class="value" id="totalJour">0 F</div>
      </div>
      <div class="stat">
        <div class="label">Transactions</div>
        <div class="value" id="nbVentes">0</div>
      </div>
      <div class="stat">
        <div class="label">Wave</div>
        <div class="value" id="totalWave">0 F</div>
      </div>
      <div class="stat">
        <div class="label">MTN MoMo</div>
        <div class="value" id="totalMTN">0 F</div>
      </div>
      <div class="stat">
        <div class="label">Orange Money</div>
        <div class="value" id="totalOrange">0 F</div>
      </div>
      <div class="stat">
        <div class="label">Espèces</div>
        <div class="value" id="totalCash">0 F</div>
      </div>
    </div>
    
    <div class="row">
      <div><button class="btn-dark" onclick="imprimerRapport()">🖨️ Imprimer Rapport</button></div>
      <div><button class="btn-dark" onclick="exporterCSV()">📊 Export Excel</button></div>
    </div>

    <h2 style="margin-top:24px">Dernières transactions</h2>
    <table id="tableVentes">
      <tr><th>Heure</th><th>Désignation</th><th>Montant</th><th>Via</th></tr>
    </table>
  </div>

  <!-- ONGLET PARAMS -->
  <div id="tabParams" class="glass hide">
    <h2>Réglages Entreprise</h2>
    <label class="label-form">Nom entreprise</label>
    <input id="editNomBiz" placeholder="Modifier le nom">
    <label class="label-form">Secteur</label>
    <input id="editSecteur" disabled>
    <button onclick="updateBusiness()">Sauvegarder</button>
    
    <h2 style="margin-top:32px">Sécurité</h2>
    <button class="btn-danger" onclick="resetDemo()">🗑️ Vider toutes les ventes démo</button>
    <p style="color:var(--muted);font-size:12px;margin-top:8px">Votre compte et nom d'entreprise seront conservés.</p>
  </div>
</div>

<!-- ZONE IMPRESSION CACHÉE -->
<div id="printArea"></div>

<!-- MENU FLOTTANT -->
<div class="float-menu">
  <button class="float-btn btn-success" onclick="switchTab('vente');show('appScreen')">💰</button>
  <button class="float-btn btn-dark" onclick="imprimerRapport()">🖨️</button>
</div>

<div class="powered">Powered by ELOHÏM-GESTION © 2026</div>

<script>
let db = JSON.parse(localStorage.getItem('elohimDB')) || {
  user:null, ventes:[], paiementActif:'Wave', produits:[]
};

const save = () => localStorage.setItem('elohimDB', JSON.stringify(db));

if(!db.user){
  show('onboardScreen');
}else{
  document.getElementById('bizNameLogin').textContent = db.user.nomBusiness;
  show('loginScreen');
}

function show(id){
  ['onboardScreen','loginScreen','appScreen'].forEach(i=>{
    document.getElementById(i).classList.add('hide');
  });
  document.getElementById(id).classList.remove('hide');
}

function creerCompte(){
  const nomBusiness = document.getElementById('nomBusiness').value.trim();
  const secteur = document.getElementById('secteur').value;
  const nom = document.getElementById('nomProprio').value.trim();
  const numero = document.getElementById('numeroProprio').value.trim();
  const mdp = document.getElementById('mdpProprio').value;
  if(!nomBusiness || !secteur || !nom || !numero || mdp.length < 4) return alert('Remplis tous les champs. Mot de passe 4 caractères min');
  db.user = {nomBusiness, secteur, nom, numero, mdp, created:Date.now()};
  save(); location.reload();
}

function connexion(){
  const numero = document.getElementById('loginNumero').value.trim();
  const mdp = document.getElementById('loginMdp').value;
  if(db.user.numero === numero && db.user.mdp === mdp){
    lancerApp();
  }else{
    alert('Numéro ou mot de passe incorrect');
  }
}

function lancerApp(){
  show('appScreen');
  document.getElementById('nomBizHeader').textContent = db.user.nomBusiness;
  document.getElementById('nomProprioHeader').textContent = db.user.nom + ' · ' + db.user.secteur;
  document.getElementById('editNomBiz').value = db.user.nomBusiness;
  document.getElementById('editSecteur').value = db.user.secteur;
  selectPay(db.paiementActif);
  updateStats();
  switchTab('vente');
}

function deconnexion(){ show('loginScreen'); }

function switchTab(tab){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('[id^="tab"]').forEach(t=>t.classList.add('hide'));
  event.target.classList.add('active');
  document.getElementById('tab'+tab.charAt(0).toUpperCase()+tab.slice(1)).classList.remove('hide');
}

function selectPay(moyen){
  db.paiementActif = moyen; save();
  document.querySelectorAll('.pay-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('btn'+moyen).classList.add('active');
}

function calcPreview(){
  const prix = parseInt(document.getElementById('prix').value) || 0;
  const qte = parseInt(document.getElementById('qte').value) || 0;
  document.getElementById('totalPreview').textContent = (prix*qte).toLocaleString();
}
document.getElementById('prix').addEventListener('input', calcPreview);
document.getElementById('qte').addEventListener('input', calcPreview);

function ajouterVente(){
  const produit = document.getElementById('produit').value.trim();
  const prix = parseInt(document.getElementById('prix').value);
  const qte = parseInt(document.getElementById('qte').value);
  if(!produit || !prix || !qte) return alert('Remplis tous les champs');
  
  db.ventes.unshift({
    produit, prix, qte, 
    total: prix * qte,
    paiement: db.paiementActif,
    timestamp: Date.now(),
    heure: new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})
  });
  save();
  document.getElementById('produit').value = '';
  document.getElementById('prix').value = '';
  document.getElementById('qte').value = 1;
  calcPreview();
  updateStats();
}

function updateStats(){
  const tbody = document.getElementById('tableVentes');
  tbody.innerHTML = '<tr><th>Heure</th><th>Désignation</th><th>Montant</th><th>Via</th></tr>';
  let total = 0, nb = 0, tWave = 0, tMTN = 0, tOrange = 0, tCash = 0;
  const aujourdhui = new Date().toDateString();
  
  db.ventes.forEach(v => {
    if(new Date(v.timestamp).toDateString() === aujourdhui){
      total += v.total; nb++;
      if(v.paiement==='Wave') tWave+=v.total;
      if(v.paiement==='MTN') tMTN+=v.total;
      if(v.paiement==='Orange') tOrange+=v.total;
      if(v.paiement==='Cash') tCash+=v.total;
      
      if(nb <= 15){
        tbody.innerHTML += `<tr>
          <td>${v.heure}</td>
          <td>${v.produit} x${v.qte}</td>
          <td>${v.total.toLocaleString()}F</td>
          <td><span class="badge badge-${v.paiement.toLowerCase()}">${v.paiement}</span></td>
        </tr>`;
      }
    }
  });
  
  document.getElementById('totalJour').textContent = total.toLocaleString() + ' F';
  document.getElementById('nbVentes').textContent = nb;
  document.getElementById('totalWave').textContent = tWave.toLocaleString() + ' F';
  document.getElementById('totalMTN').textContent = tMTN.toLocaleString() + ' F';
  document.getElementById('totalOrange').textContent = tOrange.toLocaleString() + ' F';
  document.getElementById('totalCash').textContent = tCash.toLocaleString() + ' F';
}

function updateBusiness(){
  const newName = document.getElementById('editNomBiz').value.trim();
  if(!newName) return alert('Le nom ne peut pas être vide');
  db.user.nomBusiness = newName; save();
  document.getElementById('nomBizHeader').textContent = newName;
  alert('Nom entreprise mis à jour ✅');
}

function imprimerRapport(){
  const aujourdhui = new Date().toDateString();
  const dateStr = new Date().toLocaleDateString('fr-FR',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
  let total = 0, nb = 0, tWave = 0, tMTN = 0, tOrange = 0, tCash = 0;
  let rows = '';
  
  db.ventes.forEach(v => {
    if(new Date(v.timestamp).toDateString() === aujourdhui){
      total += v.total; nb++;
      if(v.paiement==='Wave') tWave+=v.total;
      if(v.paiement==='MTN') tMTN+=v.total;
      if(v.paiement==='Orange') tOrange+=v.total;
      if(v.paiement==='Cash') tCash+=v.total;
      
      rows += `<tr>
        <td>${v.heure}</td>
        <td>${v.produit}</td>
        <td>${v.qte}</td>
        <td>${v.prix.toLocaleString()}</td>
        <td>${v.total.toLocaleString()}</td>
        <td>${v.paiement}</td>
      </tr>`;
    }
  });
  
  const html = `
    <div class="print-header">
      <h1>ELOHÏM-GESTION</h1>
      <h2>${db.user.nomBusiness}</h2>
      <p>${db.user.secteur} | Gérant: ${db.user.nom}</p>
      <p>Rapport journalier du ${dateStr}</p>
    </div>
    <div class="print-stats">
      <div class="print-stat"><strong>CA Total</strong><br>${total.toLocaleString()} FCFA</div>
      <div class="print-stat"><strong>Transactions</strong><br>${nb}</div>
      <div class="print-stat"><strong>Ticket moyen</strong><br>${nb?Math.round(total/nb).toLocaleString():0} FCFA</div>
    </div>
    <div class="print-stats">
      <div class="print-stat"><strong>Wave</strong><br>${tWave.toLocaleString()} F</div>
      <div class="print-stat"><strong>MTN MoMo</strong><br>${tMTN.toLocaleString()} F</div>
      <div class="print-stat"><strong>Orange Money</strong><br>${tOrange.toLocaleString()} F</div>
      <div class="print-stat"><strong>Espèces</strong><br>${tCash.toLocaleString()} F</div>
    </div>
    <table class="print-table">
      <thead><tr><th>Heure</th><th>Désignation</th><th>Qté</th><th>PU</th><th>Total</th><th>Paiement</th></tr></thead>
      <tbody>${rows || '<tr><td colspan="6" style="text-align:center">Aucune vente aujourd\'hui</td></tr>'}</tbody>
    </table>
    <div class="print-footer">
      <p>Document généré par ELOHÏM-GESTION le ${new Date().toLocaleString('fr-FR')}</p>
      <p>${db.user.nomBusiness} - ${db.user.numero}</p>
    </div>
  `;
  
  document.getElementById('printArea').innerHTML = html;
  window.print();
}

function exporterCSV(){
  const aujourdhui = new Date().toDateString();
  let csv = 'Heure,Produit,Qte,Prix Unitaire,Total,Paiement\n';
  
  db.ventes.forEach(v => {
    if(new Date(v.timestamp).toDateString() === aujourdhui){
      csv += `${v.heure},${v.produit},${v.qte},${v.prix},${v.total},${v.paiement}\n`;
    }
  });
  
  const blob = new Blob([csv], {type: 'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `ELOHIM-Rapport-${new Date().toISOString().split('T')[0]}.csv`;
  a.click();
}

async function resetDemo(){
  if(!confirm("Vider l'historique des transactions ?\nVotre entreprise "+db.user.nomBusiness+" sera conservée.")) return;
  db.ventes = []; save();
  
  const dbs = await indexedDB.databases();
  dbs.forEach(db => { indexedDB.deleteDatabase(db.name) });
  if('caches' in window){
    const keys = await caches.keys();
    await Promise.all(keys.map(key => caches.delete(key)));
  }
  alert("Données réinitialisées. ELOHÏM-GESTION prêt à encaisser.");
  updateStats();
}

if(db.user){ lancerApp(); }
</script>
</body>
</html>
