<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Digital - Commande WhatsApp</title>
    <style>
        * {margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif;}
        body {background: #f5f5f5; color: #333;}
        .header {background: #25D366; color: white; padding: 20px; text-align: center;}
        .header h1 {font-size: 24px; margin-bottom: 5px;}
        .container {max-width: 500px; margin: 0 auto; padding: 15px;}
        .plat {background: white; border-radius: 12px; margin-bottom: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow: hidden;}
        .plat img {width: 100%; height: 180px; object-fit: cover;}
        .plat-info {padding: 15px;}
        .plat-info h3 {font-size: 18px; margin-bottom: 5px;}
        .plat-info p {color: #666; font-size: 14px; margin-bottom: 10px;}
        .prix {font-size: 20px; font-weight: bold; color: #25D366; margin-bottom: 12px;}
        .btn-cmd {width: 100%; background: #25D366; color: white; border: none; padding: 12px; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer;}
        .wa-num {margin: 20px 0; text-align: center;}
        .wa-num input {padding: 10px; width: 80%; border: 2px solid #ddd; border-radius: 8px; text-align: center; font-size: 16px;}
        .footer {text-align: center; padding: 30px 15px; color: #888; font-size: 13px;}
    </style>
</head>
<body>
    <div class="header">
        <h1>🍗 Ton Resto Ici</h1>
        <p>Commande en 1 clic sur WhatsApp</p>
    </div>

    <div class="container">
        <div class="wa-num">
            <input type="text" id="numWhatsapp" placeholder="Numéro WhatsApp: 22507..." value="22507XXXXXXXX">
        </div>

        <!-- PLAT 1 -->
        <div class="plat">
            <img src="https://images.unsplash.com/photo-1603360946369-dc9bb6258143?w=500" alt="Plat">
            <div class="plat-info">
                <h3>Nom du Plat 1</h3>
                <p>Description du plat</p>
                <div class="prix">2.500 FCFA</div>
                <button class="btn-cmd" onclick="commander('Nom du Plat 1', 2500)">Commander sur WhatsApp</button>
            </div>
        </div>

        <!-- PLAT 2 -->
        <div class="plat">
            <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=500" alt="Plat">
            <div class="plat-info">
                <h3>Nom du Plat 2</h3>
                <p>Description du plat</p>
                <div class="prix">3.000 FCFA</div>
                <button class="btn-cmd" onclick="commander('Nom du Plat 2', 3000)">Commander sur WhatsApp</button>
            </div>
        </div>
    </div>

    <div class="footer">Propulsé par Elohim Digital 🇨🇮</div>

    <script>
        function commander(nomPlat, prix) {
            const numero = document.getElementById('numWhatsapp').value.replace(/\s/g, '');
            if(numero.length < 10){
                alert('Entre le numéro WhatsApp d\'abord 👆');
                return;
            }
            const message = `Bonjour 👋 Je veux commander :%0A%0A*${nomPlat}* - ${prix} FCFA%0A%0AMerci !`;
            const url = `https://wa.me/${numero}?text=${message}`;
            window.open(url, '_blank');
        }
    </script>
</body>
</html>
