<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion Cave La Liga - PRO</title>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#38bdf8">
    <link rel="apple-touch-icon" href="icon-192.png">
    <style>
        body { font-family: Arial, sans-serif; background: #0f172a; color: white; padding: 20px; max-width: 600px; margin: auto; }
        h1 { text-align: center; color: #38bdf8; margin-bottom: 5px; }
        .subtitle { text-align: center; color: #94a3b8; margin-bottom: 20px; }
        .card { background: #1e293b; padding: 15px; border-radius: 10px; margin-bottom: 20px; border: 1px solid #334155; }
        input, select, button { width: 100%; padding: 12px; margin: 8px 0; border-radius: 8px; border: none; box-sizing: border-box; font-size: 16px; }
        input, select { background: #334155; color: white; }
        button { font-weight: bold; cursor: pointer; }
        .btn-add { background: #f59e0b; color: #000; }
        .btn-sell { background: #3b82f6; }
        .btn-print { background: #10b981; }
        .btn-reset { background: #ef4444; margin-top: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }
        th, td { border: 1px solid #334155; padding: 8px; text-align: center; }
        th { background: #334155; }
        .stats { font-size: 18px; text-align: center; line-height: 1.8; }
        .stats span { font-weight: bold; }
        @media print {
            body { background: white; color: black; }
            .no-print { display: none; }
            .card { border: 1px solid #000; page-break-inside: avoid; }
            h1 { color: black; }
        }
    </style>
</head>
<body>
    <h1>🥤 GESTION CAVE LA LIGA PRO</h1>
    <p class="subtitle">Par Koffi Kouadio - Solution pour PME</p>

    <div class="card no-print">
        <h2>📥 ENTRÉE STOCK</h2>
        <input id="nom" placeholder="Ex: Coca 33cl">
        <input id="qte" type="number" placeholder="Quantité reçue">
        <input id="achat" type="number" placeholder="Prix d'achat unitaire CFA">
        <input id="vente" type="number" placeholder="Prix de vente unitaire CFA">
        <button class="btn-add" onclick="ajouterStock()">Ajouter au Stock</button>
    </div>

    <div class="card no-print">
        <h2>💰 VENDRE</h2>
        <select id="produitVente">
            <option>-- Choisir un produit --</option>
        </select>
        <input id="qteVente" type="number" placeholder="Quantité vendue">
        <button class="btn-sell" onclick="vendre()">Enregistrer Vente</button>
    </div>

    <div class="card" id="zoneImpression">
        <h2>📊 RÉSUMÉ DU JOUR - <span id="dateJour"></span></h2>
        <div class="stats">
            <p>CA du jour : <span id="ca" style="color:#22c55e;">0</span> CFA</p>
            <p>Bénéfice du jour : <span id="benef" style="color:#22c55e;">0</span> CFA</p>
        </div>
        
        <h2>📦 ÉTAT DU STOCK</h2>
        <table id="tableStock">
            <tr><th>Produit</th><th>Stock</th><th>Achat</th><th>Vente</th><th>Ajouté le</th></tr>
        </table>

        <h2>🧾 HISTORIQUE DES VENTES</h2>
        <table id="tableVentes">
            <tr><th>Heure</th><th>Produit</th><th>Qté</th><th>Total</th><th>Bénéfice</th></tr>
        </table>
    </div>

    <div class="card no-print">
        <button class="btn-print" onclick="window.print()">🖨️ Imprimer le Rapport du Jour</button>
        <button class="btn-reset" onclick="resetJour()">🔄 Clôturer la Journée & Reset</button>
    </div>

<script>
let stock = JSON.parse(localStorage.getItem('stockLaLiga')) || [];
let ventes = JSON.parse(localStorage.getItem('ventesLaLiga')) || [];

function sauvegarder() {
    localStorage.setItem('stockLaLiga', JSON.stringify(stock));
    localStorage.setItem('ventesLaLiga', JSON.stringify(ventes));
}

function getDateHeure() {
    return new Date().toLocaleString('fr-FR');
}

function ajouterStock() {
    let nom = document.getElementById('nom').value.trim();
    let qte = parseInt(document.getElementById('qte').value);
    let achat = parseInt(document.getElementById('achat').value);
    let vente = parseInt(document.getElementById('vente').value);
    
    if (!nom || !qte || !achat || !vente) {
        alert('Remplis les 4 cases bro');
        return;
    }
    
    let existant = stock.find(p => p.nom === nom);
    if (existant) {
        existant.qte += qte;
        existant.achat = achat;
        existant.vente = vente;
        existant.date = getDateHeure();
    } else {
        stock.push({ nom, qte, achat, vente, date: getDateHeure() });
    }
    
    document.getElementById('nom').value = '';
    document.getElementById('qte').value = '';
    document.getElementById('achat').value = '';
    document.getElementById('vente').value = '';
    
    sauvegarder();
    afficher();
}

function vendre() {
    let nom = document.getElementById('produitVente').value;
    let qte = parseInt(document.getElementById('qteVente').value);
    let produit = stock.find(p => p.nom === nom);
    
    if (!produit) {
        alert('Choisis un produit');
        return;
    }
    if (!qte || qte <= 0) {
        alert('Mets une quantité valide');
        return;
    }
    if (qte > produit.qte) {
        alert('Stock insuffisant. Il reste ' + produit.qte);
        return;
    }
    
    produit.qte -= qte;
    let totalVente = qte * produit.vente;
    let benefVente = qte * (produit.vente - produit.achat);
    
    ventes.push({
        heure: getDateHeure(),
        nom: nom,
        qte: qte,
        total: totalVente,
        benef: benefVente
    });
    
    document.getElementById('qteVente').value = '';
    sauvegarder();
    afficher();
}

function afficher() {
    document.getElementById('dateJour').textContent = new Date().toLocaleDateString('fr-FR');
    
    let select = document.getElementById('produitVente');
    select.innerHTML = '<option>-- Choisir un produit --</option>';
    stock.forEach(p => {
        if(p.qte > 0) select.innerHTML += `<option>${p.nom}</option>`;
    });
    
    let tableStock = document.getElementById('tableStock');
    tableStock.innerHTML = '<tr><th>Produit</th><th>Stock</th><th>Achat</th><th>Vente</th><th>Ajouté le</th></tr>';
    stock.forEach(p => {
        tableStock.innerHTML += `<tr><td>${p.nom}</td><td>${p.qte}</td><td>${p.achat}</td><td>${p.vente}</td><td>${p.date}</td></tr>`;
    });
    
    let tableVentes = document.getElementById('tableVentes');
    tableVentes.innerHTML = '<tr><th>Heure</th><th>Produit</th><th>Qté</th><th>Total</th><th>Bénéfice</th></tr>';
    let caTotal = 0;
    let benefTotal = 0;
    ventes.forEach(v => {
        tableVentes.innerHTML += `<tr><td>${v.heure}</td><td>${v.nom}</td><td>${v.qte}</td><td>${v.total}</td><td>${v.benef}</td></tr>`;
        caTotal += v.total;
        benefTotal += v.benef;
    });
    
    document.getElementById('ca').textContent = caTotal.toLocaleString('fr-FR');
    document.getElementById('benef').textContent = benefTotal.toLocaleString('fr-FR');
}

function resetJour() {
    if (confirm('Tu veux clôturer la journée ? Ça va effacer l’historique des ventes mais garder le stock.')) {
        ventes = [];
        sauvegarder();
        afficher();
    }
}

if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('sw.js');
}

afficher();
</script>
</body>
</html>
