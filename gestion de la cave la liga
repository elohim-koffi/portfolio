<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion Boisson - Famille Koffi</title>
    <style>
        body { font-family: Arial; background: #0d1117; color: white; padding: 15px; max-width: 1000px; margin: auto; }
        h1, h2 { color: #58a6ff; text-align: center; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px 0; }
        .box { background: #161b22; padding: 15px; border-radius: 8px; border: 1px solid #30363d; }
        input, select, button { padding: 10px; margin: 5px 0; font-size: 15px; width: 100%; box-sizing: border-box; }
        button { background: #238636; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
        .btn-sell { background: #1f6feb; }
        .btn-stock { background: #bf8700; }
        .btn-danger { background: #da3633; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #30363d; padding: 8px; text-align: left; font-size: 14px; }
        th { background: #21262d; }
        .alerte { color: #f85149; font-weight: bold; }
        .ok { color: #3fb950; font-weight: bold; }
        .total-box { font-size: 20px; text-align: center; margin: 15px 0; }
        @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <h1>🥤 GESTION MAGASIN BOISSON</h1>
    <p style="text-align: center;">Par Koffi Kouadio - Solution pour PME</p>

    <div class="grid">
        <div class="box">
            <h2>📥 ENTRÉE STOCK</h2>
            <input type="text" id="nomProduit" placeholder="Ex: Coca 33cl">
            <input type="number" id="qteEntree" placeholder="Quantité reçue">
            <input type="number" id="prixAchat" placeholder="Prix d'achat unitaire CFA">
            <input type="number" id="prixVente" placeholder="Prix de vente unitaire CFA">
            <button class="btn-stock" onclick="ajouterStock()">Ajouter au Stock</button>
        </div>

        <div class="box">
            <h2>💰 VENDRE</h2>
            <select id="produitVente"></select>
            <input type="number" id="qteVente" placeholder="Quantité vendue">
            <button class="btn-sell" onclick="vendre()">Enregistrer Vente</button>
            <div class="total-box">CA du jour : <span id="caTotal" class="ok">0</span> CFA</div>
            <div class="total-box">Bénéfice du jour : <span id="benefTotal" class="ok">0</span> CFA</div>
        </div>
    </div>

    <div class="box">
        <h2>📊 ÉTAT DU STOCK</h2>
        <table id="tableStock">
            <tr><th>Produit</th><th>Stock</th><th>Prix Achat</th><th>Prix Vente</th><th>Valeur Stock</th><th>État</th></tr>
        </table>
    </div>

    <div class="box">
        <h2>🧾 HISTORIQUE VENTES DU JOUR</h2>
        <table id="tableVentes">
            <tr><th>Heure</th><th>Produit</th><th>Qté</th><th>Total</th><th>Bénéfice</th></tr>
        </table>
        <button class="btn-danger" onclick="cloturerJournee()">🗑️ Clôturer la journée</button>
    </div>

    <script>
        let stock = JSON.parse(localStorage.getItem('stockBoisson')) || [];
        let ventes = JSON.parse(localStorage.getItem('ventesBoisson')) || [];
        
        majAffichage();

